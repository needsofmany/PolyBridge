<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PolyBridge.Api</AssemblyName>
    <RootNamespace>PolyBridge.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <Target Name="SyncWebsiteBeforeBuild" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_WebsiteFile Include="$(MSBuildProjectDirectory)\..\..\..\website\**\*"
                    Exclude="$(MSBuildProjectDirectory)\..\..\..\website\scripts\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebsiteFile)"
          DestinationFiles="@(_WebsiteFile->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_WebsiteFile)' != ''" />
  </Target>

</Project>
